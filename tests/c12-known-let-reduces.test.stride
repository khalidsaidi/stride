define by_if() -> number {
  let c = yes
  var n: number
  if c {
    n = 7
  }
  return n
}
define by_bound() -> number {
  let last = 2
  var n: number
  for i in 1..last {
    n = i
  }
  return n
}
define by_match() -> number {
  let k = "a"
  var n: number
  match k {
    "a" => {
      n = 1
    }
    else => {
    }
  }
  return n
}
expect by_if() == 7
expect by_bound() == 2
expect by_match() == 1
