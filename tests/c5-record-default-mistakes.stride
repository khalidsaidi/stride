function one() -> number {
  return 1
}
record person {
  name: string = 5
  age: number = one()
  half: number = 1 / 0
  function greet(self) -> string {
    return self.name
  }
}
record thing {
  size: number
}
let p = new person { name: "a" }
print(p.greet())
print(new thing { size: 1 }.greet())
