function noisy() -> number {
  print("inside")
  return 1
}
function bump(l: list<number>) -> number {
  l[0] = 9
  return l[0]
}
function counter(seen: list<number>) -> function() -> number {
  return function() -> number {
    append(seen, 0)
    return count(seen)
  }
}
let l = [1]
let also = l
let next = counter(l)
expect noisy() == 1
expect noisy() == 2
expect bump(l) == 9
expect l[0] == 1
expect bump(also) == 9 and l[0] == 9
expect l == [1]
expect next() == 2 and count(also) == 2
expect next() == 2
expect bump(null) == 9 faults "F023"
expect also == [1]

# rule 7.17.1 3.4
# results ["pass", "fail", "pass", "pass", "pass", "pass", "pass", "pass", "pass", "pass"]
