# asked ["people#any", "people[1].name", "people[1]#another", "people[2].name", "people[2]#another"]
# boxes {"Count": "2", "Name1": "A", "Name2": "B"}
# run at capacity no another
# answers {"people#any": "yes", "people[1].name": "A", "people[1]#another": "yes", "people[2].name": "B", "people[2]#another": "yes", "people[3].name": "C"}
