# boxes {"Count": "3", "Name1": "A", "Name2": "B", "Name3": "C"}
# run another not answered yet
# answers {"people#any": "yes", "people[1].name": "A"}
# asked ["people#any", "people[1].name", "people[1]#another"]
# boxes {"Count": "1", "Name1": "A"}
