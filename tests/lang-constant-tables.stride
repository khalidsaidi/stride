record fee { amount: number, label: string = "standard", tags: list<string> }
const fees: map<string, fee> = {"long": new fee { amount: 5 }, "short": new fee { amount: 2, label: "short" }}
const care: map<string, string> = {"basic": "Assistance", "full": "Full care"}
const one = new fee { amount: 9, tags: ["a", "b"] }
const pair = (1, "a")
const seen = set([3, 1, 3])
const nested = [{"a": [1, 2]}, {"b": [3]}]
print(fees["long"].amount, fees["long"].label, fees["short"].label, care["full"], one.tags, pair.1, seen, nested[1]["b"])
var f = fees["long"]
f.amount = 100
print(fees["long"].amount, count(fees), keys(care))
print(one)
# rule 5.3 5.3.1 11.1
# prints ["5 standard short Full care [a, b] a {3, 1} [3]", "5 2 [basic, full]", "fee { amount: 9, label: standard, tags: [a, b] }"]
