function apply(f: function(string) -> string, t: string) -> string {
  return f(t)
}
print(apply(upper, "hello"))
let r = round
print(r(3.14159, 2))
let y: function(date) -> number = year
print(y(date_of(2026, 5, 1)))
# rule 9.10
# prints ["HELLO", "3.14", "2026"]
