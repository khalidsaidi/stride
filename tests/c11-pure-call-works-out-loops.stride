define f(n: number) -> list of number most 3 {
  return [1 / n for each x in [1, 2, 3] if x > 1]
}
define g(n: number) -> number {
  var t: number = 0
  for i in 1..n {
    t += i
  }
  return t
}
define h(n: number) -> list of number most 3 {
  return [x * n for each x in [1, 2, 3]]
}
print(count(f(0)))
print(g(1.5))
print(count(h(2)))
