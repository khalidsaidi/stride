expect line("  a   b ", 0) == "a   b"
expect rest_lines("x\n a\t\tb \n c ") == "a\t\tb \n c"
expect line("\u{a0}x", 0) == "\u{a0}x"
expect line("  x\t ", 0) == "x"
expect rest_lines("a\n\u{a0}b ") == "\u{a0}b"
expect chars("a\tb c", 0, 2) == "a\tb"
expect character("a\u{a0}b", 1) == "\u{a0}"
expect chars("1-2/3.4 5", 0, 4) == "12345"
# rule 14.1
