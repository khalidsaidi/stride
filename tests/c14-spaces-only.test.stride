expect line("  a   b ", 1) == "a   b"
expect rest_lines("x\n a\t\tb \n c ") == "a\t\tb \n c"
expect line("\u{a0}x", 1) == "\u{a0}x"
expect line("  x\t ", 1) == "x"
expect rest_lines("a\n\u{a0}b ") == "\u{a0}b"
expect chars("a\tb c", 1, 3) == "a\tb"
expect character("a\u{a0}b", 2) == "\u{a0}"
expect chars("1-2/3.4 5", 1, 5) == "12345"
# rule 14.1
