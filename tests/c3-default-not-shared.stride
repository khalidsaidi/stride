const START = [0]
function grown(x: number, l: list<number> = [1], m: list<number> = START) -> list<number> {
  append(l, x)
  append(m, x)
  return l + m
}
print(grown(2))
print(grown(3))
# rule 3.4.1 9.2
# prints ["[1, 2, 0, 2]", "[1, 3, 0, 3]"]
