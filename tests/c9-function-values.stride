function double(n: number) -> number {
  return n * 2
}
function square(n: number) -> number {
  return n * n
}
function apply(f: function(number) -> number, n: number) -> number {
  return f(n)
}
function map_each(xs: list<number>, f: function(number) -> number) -> list<number> {
  var out: list<number>
  for x in xs {
    out += [f(x)]
  }
  return out
}
function shout(words: string) {
  print(upper(words))
}
function ask_yes(words: string) -> bool {
  ask answer: bool words
  return answer == true
}
print(apply(double, 21))
print(join(map_each([1, 2, 3], square), ","))
let chosen = if 1 < 2 then double else square
print(chosen(5))
let say: function(string) = shout
say("hello")
let asker = ask_yes
print(asker("Ready?"))
print(asker("Sure?"))
print(double == double)
print(double)
