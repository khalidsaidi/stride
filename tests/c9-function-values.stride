define double(n: number) -> number {
  return n * 2
}
define square(n: number) -> number {
  return n * n
}
define apply(f: function(number) -> number, n: number) -> number {
  return f(n)
}
define map_each(xs: list of number, f: function(number) -> number) -> list of number {
  var out: list of number
  for each x in xs {
    out += [f(x)]
  }
  return out
}
define shout(words: text) {
  print(upper(words))
}
define ask_yes(words: text) -> yes-no {
  ask answer: yes-no words
  return answer == yes
}
print(apply(double, 21))
print(join(map_each([1, 2, 3], square), ","))
let chosen = if 1 < 2 then double else square
print(chosen(5))
let say: function(text) = shout
say("hello")
let asker = ask_yes
print(asker("Ready?"))
print(asker("Sure?"))
print(double == double)
print(double)
