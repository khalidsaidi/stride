record p { n: number }
function change(l: list<number>, r: p, m: map<string, number>) {
  l[0] = 7
  l += [8]
  r.n = 9
  m["k"] = 10
}
var a: list<number> = [1, 2]
let r = new p { n: 1 }
var m: map<string, number>
change(a, r, m)
print(a)
print(r)
print(m)
