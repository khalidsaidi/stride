# answers {"i": 1, "j": 1}
# prints ["Ada"]
# run inner past the items
# answers {"i": 1, "j": 2}
# fault F020
# run outer past the items
# answers {"i": 2, "j": 1}
# fault F020
# run inner above the most
# answers {"i": 1, "j": 3}
# fault F004
