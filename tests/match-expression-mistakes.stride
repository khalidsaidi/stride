let n = 2
var v = 1
let a = match n { 1 => "one", 2 => 2 }
let b = match n { v => "var", else => "other" }
let c = match n { "x" => 1, else => 2 }
let d = match n { 1 => "a", 1 + 0 => "b", else => "c" }
let e = match n { else => 1, 2 => 2 }
match n {
  true => {
    print("x")
  }
}
print("{a}{b}{c}{d}{e}")
v = 2
