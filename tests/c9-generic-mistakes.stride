define choose<t>(a: t, b: t) -> t {
  return a
}
define three<t>(l: list of t most 3) -> number {
  return count(l)
}
define nothing<t>(n: list of t) -> number {
  return count(n)
}
define g<t>(l: list of t) -> number {
  return count(l)
}
