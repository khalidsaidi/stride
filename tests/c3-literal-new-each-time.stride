record p { n: number }
function make() -> list<number> {
  return [1, 2]
}
var all: list<list<number>>
for i in 1..3 {
  let row = [0]
  append(row, i)
  append(all, row)
}
print(all)
let x = make()
append(x, 3)
print(make())
var ps: list<p>
var ms: list<map<string, number>>
for i in 1..2 {
  append(ps, new p { n: 0 })
  append(ms, {"a": 0})
}
ps[0].n = 1
ms[0]["a"] = 1
print(ps)
print(ms)
let l = [1, 2, 3]
let part = l[0..1]
let sum = l + [4]
let comp = [v for v in l]
part[0] = 9
sum[0] = 9
comp[0] = 9
print(l)
