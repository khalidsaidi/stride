record p { n: number }
let people = [new p { n: 1 }, new p { n: 2 }]
for each x in people {
  x.n = x.n * 10
}
print(people)
var rows = [[1], [2]]
for each row in rows {
  row += [0]
  row[0] = 5
}
print(rows)
