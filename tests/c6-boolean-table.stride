ask a: bool "A"
function t(w: string) -> bool {
  print(w)
  return true
}
print(true and a)
print(a and t("r1"))
print(false and t("r2"))
print(true or t("r3"))
print(false or a)
print(a or t("r4"))
print((true and a) == null)
print((false or a) == null)
print(not a)
