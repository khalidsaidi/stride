define by_for() -> number {
  var y: number
  for i in 1..3 {
    y = i
  }
  return y
}
define by_each() -> number {
  var y: number
  for each x in [1, 2] {
    y = x
  }
  return y
}
define by_match() -> number {
  var y: number
  match "a" {
    "a" => {
      y = 1
    }
    else => {
    }
  }
  return y
}
expect by_for() == 3
expect by_each() == 2
expect by_match() == 1
# rule 12.1.1 11.3.2
