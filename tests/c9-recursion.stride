define factorial(n: number) -> number {
  if n <= 1 {
    return 1
  }
  return n * factorial(n - 1)
}
define even(n: number) -> yes-no {
  return if n == 0 then yes else odd(n - 1)
}
define odd(n: number) -> yes-no {
  return if n == 0 then no else even(n - 1)
}
define forever(n: number) -> number {
  return forever(n + 1)
}
print(factorial(20))
print(even(10))
print(forever(1))
