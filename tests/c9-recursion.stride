function factorial(n: number) -> number {
  if n <= 1 {
    return 1
  }
  return n * factorial(n - 1)
}
function even(n: number) -> bool {
  return if n == 0 then true else odd(n - 1)
}
function odd(n: number) -> bool {
  return if n == 0 then false else even(n - 1)
}
function forever(n: number) -> number {
  return forever(n + 1)
}
print(factorial(20))
print(even(10))
print(forever(1))
