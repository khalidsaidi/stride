define by_break() -> number {
  var n: number
  for i in 1..1 {
    n = 1
    break
  }
  return n
}
define by_continue() -> number {
  var n: number
  for i in 1..2 {
    n = i
    continue
  }
  return n
}
define inner_break() -> number {
  var n: number
  for i in 1..2 {
    for j in 1..3 {
      break
    }
    n = i
  }
  return n
}
define each_break() -> number {
  var n: number
  for each x in [5, 6] {
    n = x
    break
  }
  return n
}
expect by_break() == 1
expect by_continue() == 2
expect inner_break() == 2
expect each_break() == 5
# rule 12.1.1 7.13
