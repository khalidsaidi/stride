function outer(base: number) -> number {
  let fib = function(n: number) -> number {
    if n < 2 {
      return n + base
    }
    return fib(n - 1) + fib(n - 2)
  }
  return fib(10)
}
print(outer(0))
let fact = function(n: number) -> number {
  if n <= 1 {
    return 1
  }
  return n * fact(n - 1)
}
print(fact(5))
let xs = [1, 2, 3, 4, 5]
print(xs[1..])
print(xs[..1])
print("hello"[2..])
