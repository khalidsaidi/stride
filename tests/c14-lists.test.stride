record kid { name: text, born: number }
options letters { "b" "B"  "a" "A"  "c" "C" }
let no_items: list of number = []
let no_answers: list of yes-no = []
let ks = [new kid { name: "A", born: 2 }, new kid { name: "B", born: 1 }, new kid { name: "C", born: 2 }, new kid { name: "D" }]
let x: set of letters = ["a", "b"]
let y: set of letters = ["c", "a"]
expect count([1, 2]) == 2
expect count(no_items) == 0
expect count(x) == 2
expect join([1, empty, 2]) == "1, , 2"
expect join(["a", "b"], "-") == "a-b"
expect join(x) == "b, a"
expect first([3, 4]) == 3
expect last([3, 4]) == 4
expect first(no_items) is empty
expect first(x) == "b"
expect filled([empty, 1, empty, 2]) == [1, 2]
expect index_of(["a", "b", "a"], "a") == 1
expect index_of([1, 2], 3) == 0
expect without([1, 2, 1], 1) == [2]
expect reversed([1, 2, 3]) == [3, 2, 1]
expect sorted([3, empty, 1, 2]) == [1, 2, 3, empty]
expect sorted([3, empty, 1], descending: yes) == [3, 1, empty]
expect sorted(["b", "B", "a"]) == ["B", "a", "b"]
expect sorted([date_of(2024, 1, 2), date_of(2023, 5, 1)]) == [date_of(2023, 5, 1), date_of(2024, 1, 2)]
expect [k.name for each k in sorted(ks, by: "born")] == ["B", "A", "C", "D"]
expect [k.name for each k in sorted(ks, by: "born", descending: yes)] == ["A", "C", "B", "D"]
expect [k.name for each k in sorted(ks, by: "name", descending: yes)] == ["D", "C", "B", "A"]
expect smallest([3, empty, 1]) == 1
expect largest(["a", "b"]) == "b"
expect smallest(no_items) is empty
expect any([no, empty]) == no
expect any([no, yes])
expect not any(no_answers)
expect all(no_answers)
expect not all([yes, empty])
expect join(union(x, y)) == "b, a, c"
expect join(intersection(x, y)) == "a"
expect join(difference(x, y)) == "b"
expect count([1] + [2, 3]) == 3
expect [1] + [2] == [1, 2]
# rule 14.4 3.8
