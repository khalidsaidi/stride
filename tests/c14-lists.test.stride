record kid { name: string, born: number }
enum letters { "b" "B"  "a" "A"  "c" "C" }
let no_items: list<number> = []
let no_answers: list<bool> = []
let nothing: list<number> = null
let ks = [new kid { name: "A", born: 2 }, new kid { name: "B", born: 1 }, new kid { name: "C", born: 2 }, new kid { name: "D" }]
let x: set<letters> = ["a", "b"]
let y: set<letters> = ["c", "a"]
expect count([1, 2]) == 2
expect count(no_items) == 0
expect count(x) == 2
expect join([1, null, 2]) == "1, , 2"
expect join(["a", "b"], "-") == "a-b"
expect join(x) == "b, a"
expect first([3, 4]) == 3
expect last([3, 4]) == 4
expect first(no_items) == null
expect first(x) == "b"
expect filled([null, 1, null, 2]) == [1, 2]
expect filled(["", null, "a"]) == ["", "a"]
expect count(filled(nothing)) == 0
expect count(nothing) faults "null where a list is needed: count's l"
expect first(nothing) faults "F023"
expect join(nothing) faults "F023"
expect reversed(nothing) faults "F023"
expect index_of([1, null], null) == 1
expect count(append([1], null)) == 2
expect index_of(["a", "b", "a"], "a") == 0
expect index_of(["a", "b", "b"], "b") == 1
expect index_of([1, 2], 3) == -1
expect without([1, 2, 1], 1) == [2]
expect reversed([1, 2, 3]) == [3, 2, 1]
expect sorted([3, null, 1, 2]) faults "null where a value is needed: an item sorted puts in order"
expect sorted(filled([3, null, 1, 2])) == [1, 2, 3]
expect sorted([3, 2, 1], descending: null) == [1, 2, 3]
expect sorted(["b", "B", "a"]) == ["B", "a", "b"]
expect sorted([date_of(2024, 1, 2), date_of(2023, 5, 1)]) == [date_of(2023, 5, 1), date_of(2024, 1, 2)]
expect [k.name for k in sorted(ks[..2], by: "born")] == ["B", "A", "C"]
expect [k.name for k in sorted(ks[..2], by: "born", descending: true)] == ["A", "C", "B"]
expect sorted(ks, by: "born") faults "null where a value is needed: the field sorted puts in order by"
expect [k.name for k in sorted(ks, by: "name", descending: true)] == ["D", "C", "B", "A"]
expect smallest([3, null, 1]) faults "F023"
expect smallest([3, 1]) == 1
expect sum([1, null]) faults "null where a number is needed: an item sum adds up"
expect largest(["a", "b"]) == "b"
expect smallest(no_items) == null
expect any([false, null]) == false
expect any([false, true])
expect not any(no_answers)
expect all(no_answers)
expect not all([true, null])
expect join(union(x, y)) == "b, a, c"
expect join(intersection(x, y)) == "a"
expect join(difference(x, y)) == "b"
expect count([1] + [2, 3]) == 3
expect [1] + [2] == [1, 2]
# rule 14.4 14.0.3 3.8 F023
