expect upper("ada é") == "ADA É"
expect lower("ADA É") == "ada é"
expect upper(empty) is empty
expect title("ada o'neil-smith") == "Ada O'Neil-Smith"
expect title("ADA LOVELACE") == "Ada Lovelace"
expect capitalize("ada LOVE") == "Ada LOVE"
expect trim("  a \t  b \n ") == "a \t  b"
expect trim_start("  a  ") == "a  "
expect trim_end("  a  ") == "  a"
expect remove_prefix("Mr Smith", "Mr ") == "Smith"
expect remove_prefix("mr Smith", "Mr ") == "mr Smith"
expect remove_suffix("report.pdf", ".pdf") == "report"
expect length("😀a") == 2
expect length(empty) == 0
expect chars("123-45-6789", 3, 4) == "45"
expect chars("12.3", 2, 1) is empty
expect chars("12", 1, 9) == "2"
expect character("A-B", 1) == "B"
expect character("A-B", 0) == "A"
expect character("ab", 5) is empty
expect slice("a-b", 0, 1) == "a-"
expect slice("abc", 2, 0) is empty
expect digits("(555) 123") == "555123"
expect letters("a1é2") == "aé"
expect is_digits("123")
expect not is_digits("")
expect not is_digits("12a")
expect is_letters("abé")
expect not is_letters(empty)
expect replace("aaa", "aa", "b") == "ba"
expect replace("abc", "", "x") == "abc"
expect contains("ABC", "B")
expect contains("abc", "")
expect starts_with("Hello", "He")
expect ends_with("Hello", "lo")
expect find("Hello", "l") == 2
expect find("Hello", "He") == 0
expect find("ABC", "B") == 1
expect find("abc", "z") == -1
expect find("abc", "") == -1
expect occurrences("aaaa", "aa") == 2
expect occurrences("AbAb", "Ab") == 2
expect occurrences("abc", "") == 0
expect split("a,,b", ",") == ["a", "", "b"]
expect count(split("", ",")) == 0
expect split("abc", "") == ["a", "b", "c"]
expect split("aXbxc", "x") == ["aXb", "c"]
expect count(split(pad_left("", 999, ","), ",")) == 1000
expect line("a\n b \u{d}\nc", 1) == "b"
expect line("a\u{d}b", 1) == "b"
expect line_count("a\nb") == 2
expect line_count(empty) == 0
expect rest_lines("a\nb\nc") == "b\nc"
expect word("  a  b\tc", 2) == "c"
expect word_count("a  b") == 2
expect word_count(empty) == 0
expect pad_left("7", 3, "0") == "007"
expect pad_left("1234", 3, "0") == "1234"
expect pad_left("7", 3) == "  7"
expect pad_left("7", width: 2, padding: "-") == "-7"
expect text_of(1.50) == "1.5"
expect text_of(yes) == "yes"
expect number_of("$1,234.50") == 1234.5
expect number_of("0x10") is empty
expect number_of("1e5") is empty
expect character("abc", -1) faults "F007"
expect character("abc", 2.5) faults "F007"
expect character("abc", empty) faults "F007"
expect slice("abc", -1, 1) faults "F007"
expect line("a", 0) == "a"
expect line("a", -1) faults "F007"
expect word("a", -1) faults "F007"
expect pad_left("7", -1, "0") faults "F009"
expect pad_left("7", 3, "ab") faults "F009"
expect pad_left("7", 3, "") faults "F009"
expect pad_left(empty, 2.5, "0") faults "F009"
# rule 14.0 14.0.1 14.0.3 14.0.4 F007 F009
