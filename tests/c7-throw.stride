function open(name: string) -> string {
  if name == "" {
    throw error("no name given", code: "NONAME")
  }
  if name == "x" {
    throw "x is not a file"
  }
  return "file {name}"
}
function first(names: list<string>) -> string {
  for n in names {
    try {
      return open(n)
    } catch e {
      print("{n}: {e.code} {e.message}")
      if e.code == "F013" {
        throw e
      }
    }
  }
  return "none"
}
print(first(["", "a"]))
try {
  print(first(["", "x", "a"]))
} catch e {
  print("again {e.code} {e.message}")
}
try {
  throw null
} catch e {
  print("[{e.message}] {e.code}")
}
let words: string = "said"
try {
  throw words
} catch e {
  print(e)
}
try {
  fail("by fail")
} catch e {
  print("{e.code} {e}")
}
let throw = 3
print(throw + 1)
throw "the end"
