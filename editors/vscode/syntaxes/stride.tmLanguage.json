{
  "name": "Stride",
  "scopeName": "source.stride",
  "patterns": [
    { "include": "#comment" },
    { "include": "#header" },
    { "include": "#string" },
    { "include": "#declaration" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": { "name": "comment.line.number-sign.stride", "match": "#.*$" },
    "header": {
      "match": "^\\s*(form|pdf|fields)\\s+(\\S+)",
      "captures": { "1": { "name": "keyword.other.header.stride" }, "2": { "name": "string.unquoted.header.stride" } }
    },
    "string": {
      "name": "string.quoted.double.stride",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.stride", "match": "\\\\(u\\{[0-9A-Fa-f]{1,6}\\}|.)" },
        { "name": "meta.interpolation.stride", "begin": "\\{", "end": "\\}", "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.stride" } }, "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.stride" } }, "patterns": [{ "include": "$self" }] }
      ]
    },
    "declaration": {
      "match": "\\b(define|record|options|const|let|var|ask|collect)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": { "1": { "name": "keyword.declaration.stride" }, "2": { "name": "entity.name.stride" } }
    },
    "keyword": {
      "name": "keyword.control.stride",
      "match": "\\b(and|as|ask|because|break|check|collect|const|continue|default|define|each|else|expect|export|fill|for|if|in|is|let|list|match|most|native|new|not|of|options|or|pick|record|return|set|skip|then|tick|use|var|when)\\b"
    },
    "type": { "name": "support.type.stride", "match": "\\b(text|long-text|number|date|yes-no|phone|email|one-of|any-of)\\b" },
    "constant": { "name": "constant.language.stride", "match": "\\b(yes|no|empty)\\b" },
    "number": { "name": "constant.numeric.stride", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" },
    "call": { "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.stride" } } },
    "operator": { "name": "keyword.operator.stride", "match": "->|=>|\\.\\.|==|!=|<=|>=|\\+=|-=|\\*=|/=|//|[-+*/%<>=]" }
  }
}
