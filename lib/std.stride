# The standard library (docs/spec.md §14). Every program and every library has it without a `use`. The
# natives are written in JavaScript (runtime/natives.mjs) and declared here with their parameters,
# defaults and results; the rest is written in Stride. A native whose result is `any` gives a value of the type of
# its first argument after conversion, unless §14 specifies otherwise (`either` joins both arguments); `element`
# the list-item or set-option type of the first argument. A native without `-> type` gives
# no value: its call is a statement.
#
# Each `# example:` line is shown by `stride doc` and run by the conformance suite in every engine: what
# `stride eval` gives for it, what it prints, or the fault it stops with. The examples may use these:
#
#   options colour {
#     "red" "Red"
#     "green" "Green"
#     "blue" "Blue"
#   }
#   record person {
#     name: text
#     age: number
#   }
#   let warm: set of colour = ["red", "green"]
#   let cool: set of colour = ["green", "blue"]
#   let people: list of person most 2 = [new person { name: "Bo", age: 40 }, new person { name: "Al", age: 30 }]
#
# and the day today() gives is 2026-11-09.

# ----- words (§14.1)

# example: upper("Ab ç") gives AB Ç
export native define upper(t: text) -> text
# example: lower("Ab") gives ab
export native define lower(t: text) -> text
# example: title("anne-marie o'neil") gives Anne-Marie O'Neil
export native define title(t: text) -> text
# example: capitalize("hello world") gives Hello world
export native define capitalize(t: text) -> text
# example: "[{trim("  a   b  ")}]" gives [a b]
export native define trim(t: text) -> text
# example: "[{trim_start("  a  ")}]" gives [a  ]
export native define trim_start(t: text) -> text
# example: "[{trim_end("  a  ")}]" gives [  a]
export native define trim_end(t: text) -> text
# example: remove_prefix("Mr Smith", "Mr ") gives Smith
export native define remove_prefix(t: text, prefix: text) -> text
# example: remove_suffix("report.pdf", ".pdf") gives report
export native define remove_suffix(t: text, suffix: text) -> text
# example: length("héllo") gives 5
export native define length(t: any) -> number
# example: chars("123-45-6789", 4, 5) gives 45
export native define chars(t: text, from: number, to: number) -> text
# example: character("A1-B2", 3) gives B
export native define character(t: text, n: number) -> text
# example: slice("Hello", 2, 4) gives ell
export native define slice(t: text, from: number, to: number) -> text
# example: digits("(555) 123-4567") gives 5551234567
export native define digits(t: text) -> text
# example: letters("a1b2") gives ab
export native define letters(t: text) -> text
# example: is_digits("0123") gives yes
# example: is_digits("") gives no
export native define is_digits(t: text) -> yes-no
# example: is_letters("abc") gives yes
export native define is_letters(t: text) -> yes-no
# example: replace("a-b-c", "-", "/") gives a/b/c
export native define replace(t: text, part: text, with: text) -> text
# example: contains("Hello", "ell") gives yes
export native define contains(t: text, part: text) -> yes-no
# example: starts_with("Hello", "He") gives yes
export native define starts_with(t: text, part: text) -> yes-no
# example: ends_with("Hello", "lo") gives yes
export native define ends_with(t: text, part: text) -> yes-no
# example: find("banana", "an") gives 2
export native define find(t: text, part: text) -> number
# example: occurrences("banana", "an") gives 2
export native define occurrences(t: text, part: text) -> number
# example: split("a,b,,c", ",") gives [a, b, , c]
export native define split(t: text, separator: text) -> list of text
# example: line("one\n  two  ", 2) gives two
export native define line(t: text, n: number) -> text
# example: line_count("a\n") gives 2
export native define line_count(t: text) -> number
# example: replace(rest_lines("Name\n 12 Main St\nTown "), "\n", " / ") gives 12 Main St / Town
export native define rest_lines(t: text) -> text
# example: word("John  Q Public", 2) gives Q
export native define word(t: text, n: number) -> text
# example: word_count(" a  b c ") gives 3
export native define word_count(t: text) -> number
# example: pad_left("7", 3, "0") gives 007
export native define pad_left(t: text, width: number, padding: text = " ") -> text
# example: text_of(date_of(2026, 1, 2)) gives 2026-01-02
export native define text_of(v: any) -> text
# example: number_of("1,234.5") gives 1234.5
export native define number_of(t: text) -> number

# ----- numbers (§14.2)

# example: round(2.345, 2) gives 2.35
# example: round(-2.5) gives -3
export native define round(n: number, places: number = 0) -> number
# example: ceil(1.2) gives 2
export native define ceil(n: number) -> number
# example: floor(-1.2) gives -2
export native define floor(n: number) -> number
# example: whole(-1.7) gives -1
export native define whole(n: number) -> number
# example: abs(-3) gives 3
export native define abs(n: number) -> number
# example: power(2, 10) gives 1024
export native define power(n: number, k: number) -> number
# example: min(2, 5) gives 2
export native define min(a: number, b: number) -> number
# example: max(2, empty) gives 2
export native define max(a: number, b: number) -> number
# example: grouped(1234.5, 2) gives 1,234.50
export native define grouped(n: number, places: number = 0) -> text
# example: fixed(1234.5, 2) gives 1234.50
export native define fixed(n: number, places: number = 0) -> text
# example: divide(7, 2) gives 3.5
# example: divide(1, 0) faults F001
export native define divide(a: number, b: number) -> number
# example: remainder(7, 2) gives 1
export native define remainder(a: number, b: number) -> number

# ----- dates (§14.3)

# example: today() gives 2026-11-09
export native define today() -> date
# example: date_of(2024, 2, 29) gives 2024-02-29
# example: date_of(2023, 2, 29) is empty gives yes
export native define date_of(year: number, month: number, day: number) -> date
# example: year(date_of(2026, 7, 4)) gives 2026
export native define year(d: date) -> number
# example: month(date_of(2026, 7, 4)) gives 7
export native define month(d: date) -> number
# example: day(date_of(2026, 7, 4)) gives 4
export native define day(d: date) -> number
# example: format(date_of(2026, 7, 4), "MM/DD/YYYY") gives 07/04/2026
export native define format(d: date, pattern: text) -> text
# example: days_between(date_of(2026, 1, 1), date_of(2026, 3, 1)) gives 59
export native define days_between(from: date, to: date) -> number
# example: years_between(date_of(2000, 2, 29), date_of(2001, 2, 28)) gives 1
export native define years_between(from: date, to: date) -> number
# example: add_days(date_of(2026, 12, 31), 1) gives 2027-01-01
export native define add_days(d: date, n: number) -> date
# example: add_months(date_of(2026, 1, 31), 1) gives 2026-02-28
export native define add_months(d: date, n: number) -> date

# ----- lists and sets (§14.4)

# example: count([1, 2, 3]) gives 3
# example: count(cool) gives 2
export native define count(l: any) -> number
# A map's keys, in the order they were first given.
# example: keys({"a": 1, "b": 2}) gives [a, b]
export native define keys<k, v>(m: map of k to v) -> list of k
# A map's values, in the order of their keys.
# example: values({"a": 1, "b": 2}) gives [1, 2]
export native define values<k, v>(m: map of k to v) -> list of v
# Whether a map has a key.
# example: has({"a": 1}, "a") gives yes
export native define has<k, v>(m: map of k to v, key: k) -> yes-no
# The map without a key; the map given is not changed.
# example: remove({"a": 1, "b": 2}, "a") gives {b: 2}
export native define remove<k, v>(m: map of k to v, key: k) -> map of k to v
# example: join(["a", "b", ""], "; ") gives a; b
# example: join(warm) gives red, green
export native define join(l: any, separator: text = ", ") -> text
# example: first([4, 5]) gives 4
export native define first(l: any) -> element
# example: last([4, 5]) gives 5
export native define last(l: any) -> element
# example: filled(["a", "", "b"]) gives [a, b]
export native define filled(l: any) -> any
# example: index_of([5, 6, 7], 6) gives 2
export native define index_of(l: any, x: any) -> number
# example: append(filled(["a", "", ""]), "b") gives [a, b]
export native define append(l: any, x: any) -> any
# example: without([1, 2, 1], 1) gives [2]
export native define without(l: any, x: any) -> any
# example: reversed([1, 2, 3]) gives [3, 2, 1]
export native define reversed(l: any) -> any
# example: sorted([3, 1, 2]) gives [1, 2, 3]
# example: join([p.name for each p in sorted(people, by: "age")]) gives Al, Bo
export native define sorted(l: any, descending: yes-no = no) -> any
# example: sum([1, 2.5, empty]) gives 3.5
export native define sum(l: any) -> number
# example: smallest([3, 1, 2]) gives 1
export native define smallest(l: any) -> element
# example: largest([3, 1, 2]) gives 3
export native define largest(l: any) -> element
# example: any([no, yes]) gives yes
export native define any(l: list of yes-no) -> yes-no
# example: all([yes, no]) gives no
export native define all(l: list of yes-no) -> yes-no
# example: join(union(warm, cool)) gives red, green, blue
export native define union(a: any, b: any) -> any
# example: join(intersection(warm, cool)) gives green
export native define intersection(a: any, b: any) -> any
# example: join(difference(warm, cool)) gives red
export native define difference(a: any, b: any) -> any

# ----- empty, faults and output (§14.5)

# example: either(empty, 5) gives 5
export native define either(a: any, b: any) -> any
# example: fail("stop") faults F013
export native define fail(message: text)
# example: print(people[1]) prints person { name: Bo, age: 40 }
export native define print(v: any)
